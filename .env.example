# --- Database (Neon Postgres — free tier) ------------------------------------
# Copy both connection strings from your Neon project dashboard:
#   DATABASE_URL = the POOLED connection string (used at runtime)
#   DIRECT_URL   = the DIRECT connection string (used for schema pushes)
DATABASE_URL="postgres://...pooler...neon.tech/neondb?sslmode=require"
DIRECT_URL="postgres://...neon.tech/neondb?sslmode=require"

# --- Sign-in session ----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="generate-and-paste"
# Local dev: http://localhost:3000 — on Vercel, set this to your live URL.
NEXTAUTH_URL="http://localhost:3000"

# --- Google sign-in (optional — demo sign-in works without it) ----------------
GOOGLE_CLIENT_ID="placeholder"
GOOGLE_CLIENT_SECRET="placeholder"

# --- Mailgun emails (optional — demo mode logs emails to the terminal) --------
MAILGUN_API_KEY="placeholder"
MAILGUN_DOMAIN="placeholder"
MAILGUN_FROM_EMAIL="takumistudio26@gmail.com"
