// Midori (緑) — data model per PRD §8.
// PostgreSQL (Neon free tier) — required for Vercel, where SQLite's file-based
// storage cannot persist. The same DATABASE_URL serves local dev and production.
// Note: Postgres supports enums, but `paymentMethod` and `status` stay String
// to keep parity with the SQLite history: 'cod' | 'whatsapp', 'pending'.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// NextAuth v4 core models (canonical shape for @next-auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Application models (PRD §8.2)
// ---------------------------------------------------------------------------

model Product {
  id            String   @id // catalogue id (e.g. "vitc") is the primary key
  slug          String   @unique
  name          String
  category      String
  categoryLabel String
  caption       String
  description   String
  price         Int // GHS, whole numbers
  image         String   @default("")
  kanji         String
  meaning       String
  tags          Json     @default("[]") // JSON array of strings — SQLite has no scalar lists (approved deviation; keep Json when flipping to Postgres)
  featured      Boolean  @default(false)
  inStock       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique // format "MDR-YYYYMMDD-XXXX" (PRD §9.1)
  userId          String? // nullable → guest checkout works (PRD §8.3)
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryAddress String
  city            String
  paymentMethod   String // 'cod' | 'whatsapp'
  notes           String?
  subtotal        Int
  delivery        Int
  total           Int
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String // snapshot at order time (PRD §8.3)
  unitPrice Int // snapshot at order time
  quantity  Int
  lineTotal Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

// Per-user sync targets — defined for future use (PRD §8.2)

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

// Nurse booking requests (concierge, home care, travel) — Elizabeth confirms
// each one on WhatsApp, so there is no payment or calendar dependency here.

model Booking {
  id            String   @id @default(cuid())
  reference     String   @unique
  customerName  String
  customerPhone String
  service       String
  preferredDate String
  notes         String   @default("")
  status        String   @default("requested")
  createdAt     DateTime @default(now())
}
